# Robin V1 environment template.
# Copy this file to .env. Never commit real API keys or secrets.
# Values may also be provided as shell environment variables.
# Do not wrap values in quotes unless your shell/runtime requires it.

# --- Cloud LLM providers -----------------------------------------------------
# One working provider is enough for Robin to populate the model selector.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional custom OpenRouter gateway.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Local Ollama ------------------------------------------------------------
# IMPORTANT for direct Python / venv installs:
# config.py defaults to host.docker.internal for the Docker-oriented setup.
# When Robin and Ollama run on the same host, uncomment this:
#
# OLLAMA_BASE_URL=http://127.0.0.1:11434
#
# Robin's default Ollama context is 32768. Reduce this only when local
# RAM/VRAM/runtime constraints require it; 8192 is a reasonable starting point.
# OLLAMA_NUM_CTX=8192

# --- Other local / OpenAI-compatible providers -------------------------------
# LLAMA_CPP_BASE_URL=http://127.0.0.1:8080
# CUSTOM_API_BASE_URL=http://127.0.0.1:1234/v1
# CUSTOM_API_KEY=
# CUSTOM_API_MODEL=

# Tor is not configured through .env in Robin V1.
# Live .onion search/scraping expects SOCKS5h on 127.0.0.1:9050.
